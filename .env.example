# ─────────────────────────────────────────────
# Casdoor + NeonDB + Zeabur — Environment Vars
# Copy this to .env and fill in values
# ─────────────────────────────────────────────

# NeonDB PostgreSQL connection string
# Get from: neon.tech → your project → Connection Details → Connection string
# Use the "Pooled connection" URL for better performance
DB_CONNECTION_STRING=user=neondb_owner password=YOURPASSWORD host=ep-YOURHOST.us-east-1.aws.neon.tech port=5432 dbname=casdoor sslmode=require

# Your Casdoor public URL (set AFTER Zeabur gives you a domain)
# Format: https://your-app.zeabur.app  (no trailing slash)
CASDOOR_ORIGIN=https://your-casdoor.zeabur.app
